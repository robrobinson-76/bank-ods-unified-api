MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bank_ods

# GraphQL query protection (Ariadne layer)
GRAPHQL_MAX_DEPTH=10
GRAPHQL_MAX_ROOT_FIELDS=10
# Set to false in production to hide the schema from unknown clients
GRAPHQL_INTROSPECTION=true

# Transport enablement — everything runs in dev by default; a deployment sets
# individual transports to false until each is cleared for exposure.
# TRANSPORT_MCP_ENABLED gates the consumer MCP server (bank-ods);
# TRANSPORT_MCP_OPS_ENABLED gates the operations MCP server (bank-ods-ops,
# internal-only: raw feed inspection + operational tooling).
TRANSPORT_REST_ENABLED=true
TRANSPORT_GRAPHQL_ENABLED=true
TRANSPORT_MCP_ENABLED=true
TRANSPORT_MCP_OPS_ENABLED=true

# Data-tier exposure — which registry tiers the SDL, REST routers, MCP tool
# groups, and index bootstrap pick up (see bank_ods/models/registry.py).
EXPOSE_SEMANTIC_TIER=true
EXPOSE_RAW_TIER=true

# ── ODS Ingest (src/ods_ingest) ───────────────────────────────────────────────
# Bus. SCHEMA_REGISTRY_URL points at Apicurio's Confluent-compatible API so the
# python clients and the Debezium converters share one wire format.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081/apis/ccompat/v7
# 7-day replay window on raw topics (604800000 ms)
TOPIC_RETENTION_MS=604800000

# File adapter directories (created on demand)
INGEST_DATA_ROOT=./data/ingest
FILE_POLL_INTERVAL_S=5

# REST poll adapter → stub SaaS
SAAS_BASE_URL=http://localhost:8010
POLL_INTERVAL_S=30
POLL_OVERLAP_S=60
SAAS_PAGE_SIZE=50

# CDC source (Postgres CRM + Kafka Connect)
# Host port 5434: 5433 collides with a native PostgreSQL install on some machines
# (which answers on the port and rejects the credentials, so the failure looks
# like a password problem rather than a port clash)
CRM_DSN=postgresql://crm:crm@localhost:5434/crm
CONNECT_URL=http://localhost:8083

# Consumer tuning
CONSUMER_BATCH_SIZE=500
CONSUMER_POLL_TIMEOUT_S=1.0
CONSUMER_IDLE_TIMEOUT_S=5.0
